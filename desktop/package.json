{
  "name": "oms-desktop-suite",
  "version": "1.0.1",
  "description": "OMS Business Suite Desktop Application - Matrix Data Egypt (MDE)",
  "main": "main.cjs",
  "author": "Matrix Data Egypt",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run dist:win",
    "dist:win": "electron-builder --win",
    "dist:win:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --win --mac --linux",
    "icon": "node create-icon.cjs"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "pngjs": "^7.0.0",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "com.matrixdataegypt.oms",
    "productName": "OMS Business Suite",
    "copyright": "Copyright © 2026 Matrix Data Egypt (MDE)",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "assets/**/*",
      "config/oms-desktop.config.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "config/oms-desktop.config.json",
        "to": "config/oms-desktop.config.json"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OMS Business Suite"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
